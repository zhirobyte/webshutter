{
  "name": "webshutter-desktop",
  "version": "0.1.0",
  "description": "WebShutter desktop screenshot and domain discovery tool",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [],
  "author": "zhirobyte",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "playwright": "^1.64.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "WebShutter",
  "build": {
    "appId": "com.zhirobyte.webshutter",
    "productName": "WebShutter",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
